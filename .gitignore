# UD Spanish treebanks (AnCora + GSD) -- 71 MB, BUILD-ONLY.
# Nothing loads these at runtime; tools/build_morph.py reads them once to
# produce tools/spa_morph.json, which is the artifact the tool actually uses
# and IS committed. Re-download with the URLs in build_morph.py's docstring.
tools/*.conllu

# WordNet lexicographer files (8.5 MB), BUILD-ONLY. Read once to produce
# tools/english_animate.json, which is what the tool actually loads and IS
# committed. Re-download from globalwordnet/english-wordnet.
tools/noun.*.yaml
